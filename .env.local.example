# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 공공데이터포털(data.go.kr) "조리식품의 레시피 DB" API 활용신청 후 발급된 서비스키
FOOD_SAFETY_API_KEY=

# Google AI Studio(aistudio.google.com)에서 발급받은 Gemini API 키 — 이번 주 식단 AI 추천에 사용
GEMINI_API_KEY=

# Google Cloud Console에서 "YouTube Data API v3" 활성화 후 발급받은 API 키 — 유튜브 레시피 영상 검색에 사용
YOUTUBE_API_KEY=

# partners.coupang.com에서 발급받은 Open API 키 — 장보기 리스트의 쿠팡 링크를 파트너스 추적 링크로 변환
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
